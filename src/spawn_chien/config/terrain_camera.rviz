Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: CameraCloud (RGBD brut)
      Topic:
        Value: /chien/camera/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.015
      Style: Points
      Color Transformer: RGB8
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Carte d'elevation filtree
      Topic:
        Value: /terrain_mapping_node/elevation_cloud
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Size (m): 0.02
      Style: Boxes
      Color Transformer: AxisColor
      Axis: Z
      Enabled: true
    - Class: rviz_default_plugins/Polygon
      Name: Region convexe retenue (IIT 2023)
      Topic:
        Value: /mevius_mpc_controller/foothold_region
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 200; 0
      Enabled: true
    - Class: rviz_default_plugins/PointStamped
      Name: Appui optimise par le MPC
      Topic:
        Value: /mevius_mpc_controller/foothold
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 0; 0
      Radius: 0.03
      History Length: 8
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: CameraImage (2D RGB)
      Topic:
        Value: /chien/camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Enabled: true
  Global Options:
    Fixed Frame: odom
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: -1
        Y: 0
        Z: 0
Window Geometry:
  Width: 1600
  Height: 950
  X: 60
  Y: 40
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Selection:
    collapsed: true
  Time:
    collapsed: true
  Tool Properties:
    collapsed: true
  CameraImage (2D RGB):
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: true

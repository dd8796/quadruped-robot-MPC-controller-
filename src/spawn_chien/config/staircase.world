<?xml version="1.0" ?>
<!-- Test staircase: 3 steps of 5 cm, 0.30 m treads, 2 m wide, 0.8 m landing. Starts at x = -2.0;
     the robot walks towards -x. Steps are solid boxes down to the ground. -->
<sdf version="1.5">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="step_1">
      <static>true</static>
      <pose>-2.15 0 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.30 2.0 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 2.0 0.05</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="step_2">
      <static>true</static>
      <pose>-2.45 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.30 2.0 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 2.0 0.10</size></box></geometry>
          <material><ambient>0.65 0.65 0.7 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="step_3">
      <static>true</static>
      <pose>-2.75 0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.30 2.0 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 2.0 0.15</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="landing">
      <static>true</static>
      <pose>-3.30 0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 2.0 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 2.0 0.15</size></box></geometry>
          <material><ambient>0.8 0.8 0.85 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

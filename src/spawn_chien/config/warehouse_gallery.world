  <world name="default">
    <!-- Warehouse -> serpentine corridor (5 turns) -> roofed underground gallery.
         Yellow floor, white warehouse/corridor walls, darker stone-look gallery walls
         and ceiling with warm point lights (vs. the sun lighting the open section). -->

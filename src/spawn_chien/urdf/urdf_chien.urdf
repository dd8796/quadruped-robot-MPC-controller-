    <limit effort="35" velocity="10" lower="-3.141592653589793" upper="3.141592653589793"/>
  </joint>

  <!-- ros2_control: "effort" is claimed by the locomotion controller; "position_pid" is unused.
       position_pid gains are direct <param> children of <joint> (pos_kp/pos_ki/pos_kd). -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="leg1_abduction">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg1_flex">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.52611</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg1_knee">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">1.11101567</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="leg2_abduction">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg2_flex">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">-0.53043</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg2_knee">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">1.11062016</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="leg3_abduction">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg3_flex">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.52611</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg3_knee">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">1.11101567</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="leg4_abduction">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg4_flex">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">-0.53043</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg4_knee">
      <param name="pos_kp">300</param>
      <param name="pos_ki">0</param>
      <param name="pos_kd">15</param>
      <command_interface name="position_pid"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">1.11062016</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Classic does not apply ros2_control's state initial_value to the physical joints.
       Set the checked MuJoCo home keyframe during model load, before the first physics update. -->
  <gazebo>
    <plugin name="spawn_chien_home_pose" filename="libspawn_chien_home_pose.so">
      <joint name="leg1_abduction"><position>0.0</position></joint>
      <joint name="leg1_flex"><position>0.52611</position></joint>
      <joint name="leg1_knee"><position>1.11101567</position></joint>
      <joint name="leg2_abduction"><position>0.0</position></joint>
      <joint name="leg2_flex"><position>-0.53043</position></joint>
      <joint name="leg2_knee"><position>1.11062016</position></joint>
      <joint name="leg3_abduction"><position>0.0</position></joint>
      <joint name="leg3_flex"><position>0.52611</position></joint>
      <joint name="leg3_knee"><position>1.11101567</position></joint>
      <joint name="leg4_abduction"><position>0.0</position></joint>
      <joint name="leg4_flex"><position>-0.53043</position></joint>
      <joint name="leg4_knee"><position>1.11062016</position></joint>
    </plugin>
  </gazebo>

  <gazebo>
    <!-- CONTROLLERS_YAML_PATH is replaced by spawn_robot.py (the plugin needs a real path). -->
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>CONTROLLERS_YAML_PATH</parameters>
    </plugin>
  </gazebo>

  <!-- Ground-truth trunk pose: localization in simulation and validation. -->
  <gazebo>
    <plugin filename="libgazebo_ros_p3d.so" name="gazebo_ros_p3d">
      <ros>
        <namespace>/chien</namespace>
        <remapping>odom:=ground_truth_odom</remapping>
      </ros>
      <body_name>trunk</body_name>
      <frame_name>world</frame_name>
      <update_rate>100</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <!-- Foot contact parameters from unitree_ros go1_description (mu 0.6, ODE kp/kd). -->
  <!-- Foot bumper sensors, used for diagnostics only (the estimator uses the gait phase). -->
  <gazebo reference="leg1_foot">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <sensor name="leg1_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <contact>
        <collision>leg1_foot_collision</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="leg1_foot_contact_plugin">
        <ros>
          <namespace>/chien</namespace>
          <remapping>bumper_states:=leg1_foot_contact</remapping>
        </ros>
        <frame_name>leg1_foot</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="leg2_foot">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <sensor name="leg2_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <contact>
        <collision>leg2_foot_collision</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="leg2_foot_contact_plugin">
        <ros>
          <namespace>/chien</namespace>
          <remapping>bumper_states:=leg2_foot_contact</remapping>
        </ros>
        <frame_name>leg2_foot</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="leg3_foot">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <sensor name="leg3_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <contact>
        <collision>leg3_foot_collision</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="leg3_foot_contact_plugin">
        <ros>
          <namespace>/chien</namespace>
          <remapping>bumper_states:=leg3_foot_contact</remapping>
        </ros>
        <frame_name>leg3_foot</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="leg4_foot">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <sensor name="leg4_foot_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <contact>
        <collision>leg4_foot_collision</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="leg4_foot_contact_plugin">
        <ros>
          <namespace>/chien</namespace>
          <remapping>bumper_states:=leg4_foot_contact</remapping>
        </ros>
        <frame_name>leg4_foot</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Simulated sensors (IMU, 3D lidar) on fixed joints, negligible inertia. -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="trunk"/>
    <child link="imu_link"/>
    <!-- IMU at the trunk CoM: no lever-arm acceleration term. -->
    <origin xyz="-0.0520205 0.00128595 0.509659" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>/chien</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="lidar_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="trunk"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.05" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>900</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="lidar_plugin">
        <ros>
          <namespace>/chien</namespace>
          <remapping>~/out:=points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- RGBD camera on top of the trunk, front side, pitched down. The robot's forward axis is -x of
       the trunk frame. -->
  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <!-- On top of the trunk collision box, near its front edge, 3 cm clearance;
       ~0.43 m above the ground when standing. -->
  <joint name="camera_joint" type="fixed">
    <parent link="trunk"/>
    <child link="camera_link"/>
    <!-- Yaw pi: camera +x points to the robot's front; pitch +0.35 then tilts it down. -->
    <origin xyz="-0.30 0 0.635" rpy="0 0.35 3.14159265"/>
  </joint>

  <!-- Depth camera sensor. -->
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <!-- Standard optical frame (REP-103): rpy(-pi/2, 0, -pi/2) from camera_link. -->
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="depth" name="camera_sensor">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.47</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>B8G8R8</format>
        </image>
        <depth_camera>
        </depth_camera>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="camera_plugin">
        <ros>
          <namespace>/chien</namespace>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
